+const _NB_SSO_LOG = '/tmp/luci-netbird-sso.log';
+const _NB_SSO_PID = '/tmp/luci-netbird-sso.pid';
+const _NB_SSO_EXIT = '/tmp/luci-netbird-sso.exit';
+
+function _do_start_sso(req) {
+    let a = (req != null && req.args != null) ? req.args : (req || {});
+    let arg_url = (type(a.management_url) == 'string') ? a.management_url : '';
+    let mr = _resolve_mgmt_url(arg_url);
+    if (!mr.ok)
+        return err(CODE.INVALID_INPUT, mr.message);
+    if (access(_NB_SSO_PID, 'f')) {
+        let old_pid = trim(_read_small_text(_NB_SSO_PID));
+        if (_pid_runs(old_pid, 'netbird'))
+            return ok({ started: true });
+    }
+    _set_desired_connected(false);
+    _ensure_helper_services();
+    if (length(arg_url) > 0)
+        _persist_mgmt_url(arg_url);
+    _ensure_configured_binary();
+    let bin = resolve_netbird_bin();
+    if (bin == null)
+        return err(CODE.NOT_INSTALLED, 'The netbird binary is not installed.');
+
+    unlink(_NB_SSO_LOG);
+    unlink(_NB_SSO_EXIT);
+    let auth_cmd = _build_auth_cmd(bin, 'up', mr.url, '');
+    let cmd = 'umask 077; ( ' + auth_cmd + ' & __nbp=$!; __nbi=0; ' +
+        'while [ $__nbi -lt 600 ] && kill -0 $__nbp 2>/dev/null; do sleep 1; __nbi=$((__nbi+1)); done; ' +
+        'if kill -0 $__nbp 2>/dev/null; then kill -TERM $__nbp 2>/dev/null; sleep 1; kill -KILL $__nbp 2>/dev/null; fi; ' +
+        'wait $__nbp 2>/dev/null; __nb_rc=$?; echo $__nb_rc > ' + shell_quote(_NB_SSO_EXIT) +
+        ' ) </dev/null > ' + shell_quote(_NB_SSO_LOG) + ' 2>&1 & echo $!';
+    let started = _popen_simple(cmd);
+    let pid = trim(started.out);
+    if (!match(pid, /^[0-9]+$/))
+        return err(CODE.CONNECT_FAILED, 'Could not start the NetBird SSO login process.');
+    let fd = open(_NB_SSO_PID, 'w');
+    if (fd == null) {
+        _popen_simple('kill ' + shell_quote(pid) + ' 2>/dev/null');
+        return err(CODE.CONNECT_FAILED, 'Could not record the NetBird SSO login process.');
+    }
+    fd.write(pid);
+    fd.close();
+    _clear_runtime_error();
+    return ok({ started: true });
+}
+
+function _do_get_sso_status() {
+    if (!access(_NB_SSO_PID, 'f'))
+        return ok({ pending: false, url: '' });
+    let bin = resolve_netbird_bin();
+    if (bin == null)
+        return err(CODE.NOT_INSTALLED, 'The netbird binary is not installed.');
+    let fd = open(_NB_SSO_LOG, 'r');
+    let log = (fd != null) ? (fd.read('all') || '') : '';
+    if (fd != null) fd.close();
+    if (length(log) > 8192)
+        log = substr(log, length(log) - 8192);
+    let m = match(log, /Use this URL to log in:[[:space:]]*(https?:\/\/[^[:space:]]+)/);
+    let url = m ? m[1] : '';
+    let cm = match(log, /and enter the code ([A-Za-z0-9-]+)/);
+    let user_code = cm ? cm[1] : '';
+    let status = fetch_status_json(bin);
+    if (status.ok && status.data.management != null && status.data.management.connected) {
+        unlink(_NB_SSO_PID); unlink(_NB_SSO_EXIT); unlink(_NB_SSO_LOG);
+        _set_desired_connected(true);
+        _clear_runtime_error();
+        _apply_pending_settings();
+        return ok({ connected: true });
+    }
+    if (access(_NB_SSO_EXIT, 'f')) {
+        let rc = trim(_read_small_text(_NB_SSO_EXIT));
+        unlink(_NB_SSO_PID); unlink(_NB_SSO_EXIT); unlink(_NB_SSO_LOG);
+        _set_desired_connected(false);
+        let message = 'NetBird SSO login ended before the device connected.';
+        _persist_runtime_error(message);
+        return err(CODE.CONNECT_FAILED, message, (length(log) > 0) ? substr(log, 0, 1000) : rc);
+    }
+    let pid = trim(_read_small_text(_NB_SSO_PID));
+    if (!_pid_runs(pid, 'netbird')) {
+        unlink(_NB_SSO_PID); unlink(_NB_SSO_LOG);
+        let message = 'The NetBird SSO login process stopped unexpectedly.';
+        _persist_runtime_error(message);
+        return err(CODE.CONNECT_FAILED, message);
+    }
+    return ok({ pending: true, url: url, user_code: user_code });
+}
